<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#B8B8B8" android:endColor="#6E6E6E" android:angle="270" />
            <stroke android:width="1dip" android:color="#000000" />
        </shape>
    </item>
    <item android:top="-3dip" android:left="-3dip" android:right="-3dip">
        <shape android:shape="rectangle">
            <stroke android:width="3dip" android:color="#FF9900" />
        </shape>
    </item>
</layer-list>
